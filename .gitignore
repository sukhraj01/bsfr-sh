# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/

# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Data — CLAUDE.md §3: raw and processed datasets are never committed.
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# Run artefacts. Tables and figures are committed deliberately once they are `measured`;
# scratch logs from local iteration are not.
results/logs/*.tmp

# OS
.DS_Store
