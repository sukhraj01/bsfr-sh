# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/

# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Data — CLAUDE.md §3: raw and processed datasets are never committed.
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# EMBER (M7-10a) — too large to commit (1.87GB extracted test split, 1.6GB archive); README.md
# and the mapping code make the evaluation reproducible without the data itself.
data/external/ember/*.jsonl
data/external/ember/*.tar.bz2
data/external/ember/sha256.txt
data/external/ember/*.log

# Run artefacts. Tables and figures are committed deliberately once they are `measured`;
# scratch logs from local iteration are not.
results/logs/*.tmp

# OS
.DS_Store
